# Project source
GIT_REPO_URL=https://github.com/OWNER/REPOSITORY.git
GIT_REPO_DIR=/proj/project
GIT_CLONE_DEPTH=1

# S3, R2, MinIO, or another S3-compatible source
S3_URI=s3://BUCKET/OPTIONAL_PREFIX
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
SYNC_DIRS=
FORCE_SYNC=0
S3_ENTRYPOINT_URI=

# Tailscale
TS_AUTHKEY=
TS_HOSTNAME=gpu-box
TS_TAGS=tag:gpu
TS_ACCEPT_DNS=false
TS_ENABLE_SSH=true
TS_EXTRA_ARGS=
